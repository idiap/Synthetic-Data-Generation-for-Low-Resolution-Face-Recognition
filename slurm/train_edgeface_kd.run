#!/bin/bash
#
# SPDX-FileCopyrightText: © 2026 Idiap Research Institute <contact@idiap.ch>
# SPDX-FileContributor: Luis S. Luevano <luis.luevano@idiap.ch>
#
# SPDX-License-Identifier: BSD-3-Clause
#
# Script: train_edgeface_kd.run
#
# Knowledge distillation: a frozen HR-trained EdgeFace-S teacher supervises an
# LR student of identical architecture, matching L2-normalised embeddings and
# sampled PartialFC weights on top of the CosFace loss.
#
# Two earlier runs must exist, and both sets of checkpoints are loaded:
#
#   teacher  edgeface_s_gamma_05/checkpoint_gpu_{rank}.pt
#            (HR baseline, slurm/train_edgeface_hr.run) — loaded frozen by
#            train_v2_kd.py via config.teacher_checkpoint.
#   student  edgeface_s_gamma_05_lr_<size>_<down>_<up>/checkpoint_gpu_*.pt
#            (LR backbone, slurm/train_edgeface_lr.run) — the student is
#            warm-started from these. On the first launch this script copies
#            them into the KD output directory, where config.resume = True
#            picks them up; distillation then continues training from the LR
#            run's epoch counter (100 -> num_epoch = 200).
#
# The checkpoints are per-rank shards, so the KD run must use the same number
# of GPUs as the runs that produced them (4 throughout this repository).
#
# Usage:
#   sbatch slurm/train_edgeface_kd.run <interp_down> <interp_up> <size> [--resume-override]
#
# Example:
#   sbatch slurm/train_edgeface_kd.run cubic area 56

#SBATCH --job-name=edgeface_kd
#SBATCH --time=8:00:00
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --mem=32G
#SBATCH --output=logs/edgeface_kd_%A_%a.out
#SBATCH --error=logs/edgeface_kd_%A_%a.err

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

INTERP_DOWN="${1:?usage: train_edgeface_kd.run <interp_down> <interp_up> <size> [--resume-override]}"
INTERP_UP="${2:?missing <interp_up>}"
SIZE="${3:?missing <size>}"
shift 3

DATA_DIR="processed_downsample_${SIZE}_${INTERP_DOWN}_${INTERP_UP}_webface4m"

TEACHER_DIR="edgeface_s_gamma_05"
STUDENT_LR_DIR="edgeface_s_gamma_05_lr_${SIZE}_${INTERP_DOWN}_${INTERP_UP}"
KD_OUT_DIR="${STUDENT_LR_DIR}_kd_HR"

# Teacher: the frozen HR baseline, loaded per rank by train_v2_kd.py.
if [ ! -f "$TEACHER_DIR/checkpoint_gpu_0.pt" ]; then
    echo "ERROR: teacher checkpoints not found in $TEACHER_DIR/." >&2
    echo "       Train the HR baseline first: sbatch slurm/train_edgeface_hr.run" >&2
    exit 1
fi

# Student: warm-started from the LR backbone. Copy its checkpoints into the KD
# output directory on the first launch; config.resume = True then loads them
# (backbone + PartialFC + epoch counter). Later launches find the KD run's own
# checkpoints here and resume from those instead.
if [ ! -f "$KD_OUT_DIR/checkpoint_gpu_0.pt" ]; then
    if [ ! -f "$STUDENT_LR_DIR/checkpoint_gpu_0.pt" ]; then
        echo "ERROR: LR backbone checkpoints not found in $STUDENT_LR_DIR/." >&2
        echo "       Train the LR student init first:" >&2
        echo "       sbatch slurm/train_edgeface_lr.run $INTERP_DOWN $INTERP_UP $SIZE" >&2
        exit 1
    fi
    echo "Warm-starting student: copying $STUDENT_LR_DIR/checkpoint_gpu_*.pt -> $KD_OUT_DIR/"
    mkdir -p "$KD_OUT_DIR"
    cp "$STUDENT_LR_DIR"/checkpoint_gpu_*.pt "$KD_OUT_DIR"/
fi

# Distillation reads two records per step: the degraded student input and the
# pristine teacher input. The config expects them under these exact names.
stage_rec "${DATA_DIR}_kd"        "$DATA_DIR"             webface4m
stage_rec "HR_for_${DATA_DIR}_kd" passthrough_webface4m
use_staged_data

PORT="$(master_port)"
echo "Using master port: $PORT"

activate_env train

torchrun --nproc_per_node="$NPROC_PER_NODE" --master_port="$PORT" \
    train_v2_kd.py "configs/edgeface_s_gamma_05_lr_${SIZE}_${INTERP_DOWN}_${INTERP_UP}_kd_HR.py" "$@"
