# SPDX-FileContributor: Luis S. Luevano <luis.luevano@idiap.ch>
#
# SPDX-License-Identifier: BSD-3-Clause
#
# Script: train_edgeface_noup32_esrgan.run
#
# Medium-effort synthesis, recognizer side: EdgeFace-S with its 4x4 stride-4
# stem replaced by a 1x1 convolution, trained directly on the 32x32
# Real-ESRGAN-degraded record with no upsampling anywhere in the pipeline.
#
# Needs the 32x32 verification bins to exist alongside the record; generate
# them with scripts/generate_lr_bin.py first (see the config for the exact
# invocations).
#
# Usage:
#   sbatch slurm/train_edgeface_noup32_esrgan.run [--resume-override]

#SBATCH --job-name=edgeface_noup32
#SBATCH --time=8:00:00
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --mem=32G
#SBATCH --output=logs/edgeface_noup32_esrgan_%A_%a.out
#SBATCH --error=logs/edgeface_noup32_esrgan_%A_%a.err

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

DATA_DIR="processed_noup_32_esrgan_passthrough_webface4m"

# Both the record and the bins come from the degraded folder here: at 32 px the
# verification pairs have to be degraded the same way as the training data.
stage_rec "$DATA_DIR" "$DATA_DIR" "$DATA_DIR"
use_staged_data

PORT="$(master_port)"
echo "Using master port: $PORT"

activate_env train

torchrun --nproc_per_node="$NPROC_PER_NODE" --master_port="$PORT" \
    train_v2.py configs/edgeface_s_gamma_05_noup_32_esrgan.py "$@"
