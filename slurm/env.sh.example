# Script: env.sh.example
#
# Site configuration for the SLURM launchers in slurm/.
#
# Copy this file to slurm/env.sh and edit it for your machine:
#
#     cp slurm/env.sh.example slurm/env.sh
#
# slurm/env.sh is git-ignored, so your local paths never end up in a commit.
# Every value below is a default that an already-exported environment variable
# overrides, so you can also configure everything from the shell or from
# `sbatch --export=...` without editing this file at all.

# --------------------------------------------------------------------------- #
# Conda                                                                        #
# --------------------------------------------------------------------------- #
# Path to your conda/mamba binary and the environments to activate. Training
# and evaluation may use the same environment; CONDA_ENV_EVAL exists because
# the evaluation scripts additionally need insightface and scipy<=1.8.1.
: "${CONDA_BIN:=$HOME/miniforge3/bin/conda}"
: "${CONDA_ENV:=edgeface}"
: "${CONDA_ENV_EVAL:=$CONDA_ENV}"

# --------------------------------------------------------------------------- #
# Repository                                                                   #
# --------------------------------------------------------------------------- #
# Resolved automatically from the location of this file. Only set it by hand if
# you submit jobs from a copy of the launchers kept outside the repository.
: "${CODEBASE_PATH:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# --------------------------------------------------------------------------- #
# Datasets                                                                     #
# --------------------------------------------------------------------------- #
# Root holding the preprocessed .rec/.idx/.bin datasets. This is the same
# variable that configs/paths.py reads, so training and the launchers always
# agree on where the data lives.
: "${LRFR_DATA_ROOT:=$CODEBASE_PATH/data}"

# Roots of the two evaluation corpora that are not distributed as .rec files.
: "${TINYFACE_ROOT:=$LRFR_DATA_ROOT/tinyface}"
: "${IJBC_ROOT:=$LRFR_DATA_ROOT/IJBC}"

# Where the launchers assemble the per-run dataset views (the KD and PDT
# recipes need LR and HR records side by side under matching names). Files are
# hard-linked when possible, so this is cheap on the same filesystem.
#
# On a cluster, point this at fast node-local storage to avoid hammering the
# shared filesystem during training, e.g.
#     STAGE_DIR="$SLURM_TMPDIR/lrfr"
: "${STAGE_DIR:=$LRFR_DATA_ROOT/staging}"

# --------------------------------------------------------------------------- #
# Cluster specifics                                                            #
# --------------------------------------------------------------------------- #
# Set to 1 on a site that exposes CUDA/cuDNN through Lmod modules. Leave at 0
# if your conda environment already ships the CUDA runtime.
: "${LOAD_CLUSTER_MODULES:=0}"

# Number of GPUs per node used by torchrun. Keep in sync with the
# `#SBATCH --gpus-per-node` directive in the launcher you submit.
: "${NPROC_PER_NODE:=4}"

# NOTE: `#SBATCH --account` and `#SBATCH --constraint` are deliberately absent
# from the launchers, because SLURM parses those directives before this file is
# read. Pass them on the command line instead:
#
#     sbatch --account=<your-account> --constraint="rtx3090|v100" \
#         slurm/train_edgeface_lr.run cubic area 56
