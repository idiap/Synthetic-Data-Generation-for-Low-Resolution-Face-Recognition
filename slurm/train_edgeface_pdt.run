# SPDX-License-Identifier: BSD-3-Clause
#
# Script: train_edgeface_pdt.run
#
# Input-side adaptation: train a Prepended Domain Transformer in front of a
# frozen HR-trained EdgeFace-S, with a contrastive loss over PK-sampled
# LR/HR batches. The backbone is never updated.
#
# Requires the HR baseline first (the config freezes
# edgeface_s_gamma_05/checkpoint_gpu_0.pt).
#
# Usage:
#   sbatch slurm/train_edgeface_pdt.run <interp_down> <interp_up> <size> [--resume-override]
#
# Example:
#   sbatch slurm/train_edgeface_pdt.run cubic area 56

#SBATCH --job-name=edgeface_pdt
#SBATCH --time=8:00:00
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --mem=64G
#SBATCH --output=logs/edgeface_pdt_%A_%a.out
#SBATCH --error=logs/edgeface_pdt_%A_%a.err

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

INTERP_DOWN="${1:?usage: train_edgeface_pdt.run <interp_down> <interp_up> <size> [--resume-override]}"
INTERP_UP="${2:?missing <interp_up>}"
SIZE="${3:?missing <size>}"
shift 3

DATA_DIR="processed_downsample_${SIZE}_${INTERP_DOWN}_${INTERP_UP}_webface4m"

# PK sampling walks the LR and HR loaders with the same seed, so both records
# must be present and share the label space.
stage_rec "$DATA_DIR"          "$DATA_DIR"             webface4m
stage_rec "HR_for_${DATA_DIR}" passthrough_webface4m
use_staged_data

PORT="$(master_port)"
echo "Using master port: $PORT"

activate_env train

torchrun --nproc_per_node="$NPROC_PER_NODE" --master_port="$PORT" \
    train_PDT.py "configs/edgeface_s_gamma_05_PDT_${SIZE}_${INTERP_DOWN}_${INTERP_UP}.py" "$@"
