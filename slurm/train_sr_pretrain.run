# SPDX-FileContributor: Luis S. Luevano <luis.luevano@idiap.ch>
#
# SPDX-License-Identifier: BSD-3-Clause
#
# Script: train_sr_pretrain.run
#
# High-effort synthesis, stage 1: pretrain the learned 32->112 upsampler on
# (LR-32, HR-112) pairs with an L1 term plus an identity-aware cosine term
# computed through the frozen EdgeFace-base embedding.
#
# Usage:
#   sbatch slurm/train_sr_pretrain.run <espcn|resrgan> [--resume-override]
#
# The resulting sr_pretrain_<variant>/sr_pretrained.pt warm-starts stage 2,
# slurm/train_pdt_up32.run.

#SBATCH --job-name=sr_pretrain
#SBATCH --time=8:00:00
#SBATCH --gpus-per-node=4
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --mem=32G
#SBATCH --output=logs/sr_pretrain_%A_%a.out
#SBATCH --error=logs/sr_pretrain_%A_%a.err

source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"

VARIANT="${1:?usage: train_sr_pretrain.run <espcn|resrgan> [--resume-override]}"
shift
case "$VARIANT" in
    espcn|resrgan) ;;
    *) echo "ERROR: variant must be 'espcn' or 'resrgan', got '$VARIANT'." >&2; exit 1 ;;
esac

SUFFIX=""
[ "$VARIANT" = "resrgan" ] && SUFFIX="_resrgan"

stage_rec "HR_for_PDT_passthrough_webface4m${SUFFIX}" \
          passthrough_webface4m webface4m
stage_rec "LR_for_PDT_processed_noup_32_esrgan_webface4m${SUFFIX}" \
          processed_noup_32_esrgan_passthrough_webface4m \
          processed_noup_32_esrgan_passthrough_webface4m
use_staged_data

PORT="$(master_port)"
echo "Using master port: $PORT"

activate_env train

torchrun --nproc_per_node="$NPROC_PER_NODE" --master_port="$PORT" \
    train_sr_pretrain.py --config "configs/sr_pretrain_${VARIANT}.py" "$@"
